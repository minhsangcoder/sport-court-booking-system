# Copy to .env and replace every marker. Never commit .env.
POSTGRES_USER=__REPLACE_WITH_LOCAL_POSTGRES_USER__
POSTGRES_PASSWORD=__REPLACE_WITH_LOCAL_POSTGRES_PASSWORD__
REDIS_PASSWORD=__REPLACE_WITH_LOCAL_REDIS_PASSWORD__
RABBITMQ_DEFAULT_USER=__REPLACE_WITH_LOCAL_RABBITMQ_USER__
RABBITMQ_DEFAULT_PASS=__REPLACE_WITH_LOCAL_RABBITMQ_PASSWORD__
MINIO_ROOT_USER=__REPLACE_WITH_LOCAL_MINIO_USER__
MINIO_ROOT_PASSWORD=__REPLACE_WITH_LOCAL_MINIO_PASSWORD__
JWT_SECRET=__REPLACE_WITH_LOCAL_JWT_SECRET_AT_LEAST_32_BYTES__
DEMO_PAYMENT_CALLBACK_SECRET=__REPLACE_WITH_SEPARATE_DEMO_SECRET_AT_LEAST_32_BYTES__
SERVICE_CALL_SECRET=__REPLACE_WITH_SEPARATE_SERVICE_SECRET_AT_LEAST_32_BYTES__
# Independent AES-256 key: Base64 of exactly 32 random bytes. Missing key disables legal-data writes safely.
OWNER_APPLICATION_DATA_KEY=__REPLACE_WITH_BASE64_32_RANDOM_BYTES__
CORS_ALLOWED_ORIGIN=http://localhost:13000
GATEWAY_RATE_LIMIT_REPLENISH_RATE=20
GATEWAY_RATE_LIMIT_BURST_CAPACITY=40
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to APP_PUBLIC_URL + /api/v1/auth/oauth2/callback/google.
# Register that exact URL as an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Enable for HTTPS deployments; keep false for local HTTP.
SECURE_COOKIE=false
# Enable Maps JavaScript API + Places API (New), and allow both in the key's API restrictions.
# Website restriction for the local demo: http://localhost:13000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Configure an SMTP server to deliver verification, reset and notification emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Optional host-port overrides
GATEWAY_PORT=18080
FRONTEND_PORT=13000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Holding commands also share a server-enforced limit of 5 requests per 60 seconds per user.
# Redis must be available for new holds/acquisitions; existing payment callbacks keep their own flow.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Explicit local/demo opt-in. live/prod/production forces REAL and excludes demo adapters/seeds.
SPRING_PROFILES_ACTIVE=local
DEMO_SEED_ENABLED=true
DEMO_SMS_ENABLED=false
DEMO_PASSWORD=SportHub123@
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PEER_EVIDENCE_BUCKET=sporthub-peer-evidence
SPORTHUB_PEER_RESALE_FACILITIES=
# Latest proposal guards; reconcile existing data before upgrading an existing installation.
# Bank registration also needs PAYMENT_SECRET_KEYS; never invent or expose an Owner payOS key.
SPORTHUB_BANK_PROFILE_ENFORCEMENT=true
SPORTHUB_HOLD_PROTECTION_ENABLED=true
APP_PUBLIC_URL=http://localhost:13000
GROUP_PAYMENT_DEADLINE_SECONDS=1800
GROUP_MIN_LEAD_SECONDS=7200
# UC-6.7 implementation default only; ISO-8601 duration, minimum PT1S. Server owns cooldown.
GROUP_REMINDER_MIN_INTERVAL=PT15M

# REAL receiving: Owner configures each facility's SePay account and webhook key privately.
# Never put webhook keys or historical payOS credentials in frontend, URLs, logs, or this file.
SPORTHUB_MONEY_MODE=REAL
SPORTHUB_COLLECTION_PROVIDER=SEPAY
SEPAY_COLLECTION_CREATE_ENABLED=true
# Enable only after Owner channels, refund policies and callback HTTPS are configured.
PAYOS_COLLECTION_CREATE_ENABLED=false
# Optional public HTTPS origin for SePay/payOS callbacks, separate from the app URL.
PAYMENT_WEBHOOK_ORIGIN=
# AES-256 key ring: first id writes, retained ids decrypt old revisions. See docs/payment-secret-rotation.md.
# Example structure only: key2026:<Base64 of 32 random bytes>
PAYMENT_SECRET_KEYS=
