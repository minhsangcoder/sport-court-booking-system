# ═══════════════════════════════════════════════════════════════
# SportHub Backend — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Build output ──────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ───────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.code-workspace
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
application-local.yml
application-secret.yml

# ── Docker data (volumes are managed by Docker) ──────────────
docker/data/

# ── Maven wrapper ────────────────────────────────────────────
.mvn/
mvnw
mvnw.cmd
