    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
