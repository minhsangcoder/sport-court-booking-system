    "format:check": "node scripts/format-refactor.mjs",
    "check:modules": "node ../scripts/refactor/check-modules.mjs",
    "lint:refactor": "node scripts/lint-refactor.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
